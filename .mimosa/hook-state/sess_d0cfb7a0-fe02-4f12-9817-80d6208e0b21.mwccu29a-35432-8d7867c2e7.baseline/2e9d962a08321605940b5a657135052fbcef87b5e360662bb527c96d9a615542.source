[workspace]
# cargo-fuzz 需要 nightly 与独立 target，不并入 workspace。
members = ["."]
exclude = ["fuzz"]

[package]
name = "trit-immune"
version = "0.1.0"
edition = "2021"
rust-version = "1.88"
license = "MIT OR Apache-2.0"
description = "三进制免疫系统核心：{-1,0,+1} 渗透测试裁决 + DeltaDB 式因果 DAG（Kleene K3）"
readme = "README.md"
repository = "https://github.com/bfxh/trit-immune"
keywords = ["ternary", "kleene", "security", "crdt", "audit"]
categories = ["cryptography::cryptocurrencies", "data-structures"]

[features]
default = ["full"]
# 工具层（人体工程与集成面）：--no-default-features = 内核形态
full = []
# 可选 TLS 传输面；默认构建不引入任何非三进制依赖
tls = ["dep:rustls", "dep:rustls-pemfile", "dep:rcgen"]

[[bin]]
name = "trit-immune"
path = "src/bin/trit.rs"
required-features = ["full"]

[lints.rust]
# Kani 模型检查的 cfg 门（src/kani_proofs.rs，cargo kani 才编译）
unexpected_cfgs = { level = "allow", check-cfg = ['cfg(kani)'] }

[dependencies]
# 唯一必选依赖：三进制库本体（Kleene K3 / Ł3 / B3 的 Ternary）。
trit-core = { git = "https://github.com/bfxh/trit", branch = "main", package = "trit-core" }
rustls = { version = "0.23", default-features = false, features = ["ring", "std"], optional = true }
rustls-pemfile = { version = "2", optional = true }
rcgen = { version = "0.13", optional = true }
